{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "backend",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "port": 8000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd mobile && flutter run -d web-server --web-port=8090"
      ],
      "port": 8090
    }
  ]
}
