# Application Configuration
APP_NAME="MyCommunity API"
APP_VERSION="1.0.0"
ENVIRONMENT=development  # development, testing, production
DEBUG=True
API_PREFIX=/api

# Database Configuration
# DATABASE_URL is required. Example format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://mycommunity_user:your_password_here@localhost:5432/mycommunity
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mycommunity_user
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=mycommunity

# Security Configuration (JWT / Session Management)
# Generate secure keys using: openssl rand -hex 32
# SECRET_KEY is required (falls back to JWT_SECRET_KEY if not provided)
SECRET_KEY=your_jwt_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# CORS Settings
# Comma-separated list or JSON-formatted array of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
