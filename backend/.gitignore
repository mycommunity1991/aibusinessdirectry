MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
/*.manifest
/*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosenv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.stats

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# OS-specific
.DS_Store

# Local file uploads (PRO-002, Decision 2, `Plan_S04_PRO-002.md`) --
# `LocalFileStorage`'s default `UPLOAD_DIR`, explicitly interim until a
# future story adds real cloud (S3) storage.
/uploads/

# Private local file uploads (VER-001, Decision 7, `Plan_S05_VER-001.md`)
# -- `LocalFileStorage`'s default `VERIFICATION_UPLOAD_DIR`, a second,
# separate root from `/uploads/` above, never served publicly.
/uploads_private/
