  "@phoneEntrySubtitle": {
    "description": "Subtitle on the Sign In / Sign Up screen (S-03)."
  },
  "continueWithGoogle": "Continue with Google",
  "@continueWithGoogle": {
    "description": "Disabled Google sign-in option label (wired in AUTH-002, not this story)."
  },
  "continueWithApple": "Continue with Apple",
  "@continueWithApple": {
    "description": "Disabled Apple sign-in option label (wired in AUTH-002, not this story)."
  },
  "comingSoonLabel": "Coming soon",
  "@comingSoonLabel": {
    "description": "Badge shown on the disabled Google/Apple sign-in options."
