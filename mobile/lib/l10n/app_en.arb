  "phoneNumberFieldHint": "501234567",
  "@phoneNumberFieldHint": {
    "description": "Example hint text for the phone number field."
  },
  "continueWithMobileNumber": "Continue with Mobile Number",
  "@continueWithMobileNumber": {
    "description": "Primary action on the Sign In / Sign Up screen that requests an OTP."
  },
  "countryCodeInvalidError": "Enter a valid country code, e.g. +971.",
  "@countryCodeInvalidError": {
    "description": "Inline validation message for an invalid country code."
  },
  "phoneNumberInvalidError": "Enter a valid mobile number.",
  "@phoneNumberInvalidError": {
    "description": "Inline validation message for an invalid phone number."
  },
  "termsAndPrivacyNotice": "By continuing, you agree to our Terms of Service and Privacy Policy.",
  "@termsAndPrivacyNotice": {
    "description": "Footnote on the Sign In / Sign Up screen."
  },
  "otpSentConfirmation": "We've sent you a verification code.",
  "@otpSentConfirmation": {
    "description": "Snackbar confirmation shown after an OTP request succeeds."
  },

  "otpEntryTitle": "Verify your number",
  "@otpEntryTitle": {
    "description": "Title on the Mobile OTP Entry screen (S-04)."
  },
  "otpEntrySubtitle": "Enter the 6-digit code sent to {phone}",
  "@otpEntrySubtitle": {
    "description": "Subtitle on the OTP Entry screen showing the destination phone number.",
    "placeholders": {
      "phone": {
        "type": "String",
        "example": "+971 501234567"
      }
    }
  },
  "otpCodeFieldLabel": "Verification code",
  "@otpCodeFieldLabel": {
    "description": "Label for the 6-digit OTP input field."
  },
  "otpIncompleteError": "Enter all 6 digits.",
  "@otpIncompleteError": {
    "description": "Inline validation message shown while the OTP code is incomplete."
  },
  "verifyLabel": "Verify",
  "@verifyLabel": {
    "description": "Primary action on the OTP Entry screen."
  },
  "resendCodeLabel": "Resend code",
  "@resendCodeLabel": {
    "description": "Label for the resend-code action, enabled once the countdown reaches zero."
  },
  "resendCodeCountdown": "Resend code in {time}",
  "@resendCodeCountdown": {
    "description": "Countdown shown while the resend action is disabled, matching the OTP's 5-minute server-side expiry.",
    "placeholders": {
      "time": {
        "type": "String",
        "example": "4:59"
      }
    }
  },
  "otpChangeNumberLabel": "Change number",
  "@otpChangeNumberLabel": {
    "description": "Link back to the Sign In / Sign Up screen to correct the phone number."
  },

  "otpInvalidCodeMessage": "That code didn't work. Check the digits and try again.",
  "@otpInvalidCodeMessage": {
    "description": "Plain-language error shown when an OTP code is wrong, expired, or already used (backend 400, InvalidOtpError). Deliberately generic — never reveals which."
  },
  "otpTooManyAttemptsMessage": "Too many attempts. Please wait a moment before trying again.",
  "@otpTooManyAttemptsMessage": {
    "description": "Plain-language error shown after too many incorrect OTP attempts (OTP locked, backend 429 OtpLockedError) or too many requests in a short time (rate limited, backend 429 RateLimitExceededError) — both currently map to the same client error type, so this copy is phrased to read sensibly for either."
  },

  "networkErrorMessage": "We couldn't connect. Check your internet connection and try again.",
  "@networkErrorMessage": {
    "description": "Plain-language error shown when a request fails with no server response."
  },
  "genericErrorMessage": "Something went wrong. Please try again.",
  "@genericErrorMessage": {
    "description": "Plain-language fallback error for unexpected/unrecognized failures. Never includes a status code or internal identifier."
  },
  "identityVerificationFailedMessage": "We couldn't verify your sign-in. Please try again.",
  "@identityVerificationFailedMessage": {
    "description": "Plain-language error shown when a Google/Apple sign-in fails for any reason other than user cancellation (invalid/expired/tampered ID token, backend 401 InvalidIdentityTokenError, or a native plugin failure). Mirrors the backend's own generic AC6 copy but is client-owned and localized, never the backend's raw message."
  },

  "homePlaceholderTitle": "You're signed in",
  "@homePlaceholderTitle": {
    "description": "Title on the temporary post-authentication placeholder screen."
  },
  "homePlaceholderMessage": "Home is coming soon.",
  "@homePlaceholderMessage": {
    "description": "Body copy on the temporary post-authentication placeholder screen."
  },

  "logOutLabel": "Log out",
  "@logOutLabel": {
    "description": "Label for the sign-out action on the temporary post-authentication placeholder screen (AUTH-003)."
  }
}
